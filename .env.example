# Lovable Cloud → Project settings → Secrets (copy into .env for local dev).
# Published Lovable apps inject these automatically.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional legacy alias (same value as publishable key):
# VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-side (SSR / middleware) — usually set by Lovable Cloud:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Local-only auth/jobs without cloud (development only):
# VITE_ALLOW_LOCAL_DEV=true
