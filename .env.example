# Lovable Cloud → Project settings → Secrets (copy into .env for local dev).
# Published Lovable apps inject these automatically.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional legacy alias (same value as publishable key):
# VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-side (SSR signup + admin writes) — copy from Lovable Cloud → Secrets for local/Cursor preview:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=same-as-VITE_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
#
# Without SUPABASE_SERVICE_ROLE_KEY, signup still works via client fallback; profile writes may need the DB trigger.

# Local-only auth/jobs without cloud (development only):
# VITE_ALLOW_LOCAL_DEV=true
